{
  "name": "@modekit/vue",
  "version": "0.0.0",
  "description": "Accessible, feature-rich UI components for Vue.",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./preflight.css": {
      "types": "./dist/preflight.css.d.ts",
      "default": "./dist/preflight.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "pnpm build && playwright test --config playwright.config.ts",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.3",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "3.7.0"
  }
}
