{
  "name": "modekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:changesets && pnpm test:release && pnpm test:package",
    "changeset": "changeset",
    "docs:dev": "pnpm --filter @modekit/docs dev",
    "docs:preview": "pnpm --filter @modekit/docs preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "release:publish": "changeset publish",
    "release:status": "changeset status --verbose",
    "release:version": "changeset version",
    "test": "pnpm --recursive --if-present test",
    "test:changesets": "node scripts/validate-changesets.mjs",
    "test:package": "pnpm --filter @modekit/vue build && node scripts/validate-package.mjs",
    "test:release": "node scripts/validate-release-automation.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vue-eslint-parser": "10.4.1",
    "yaml": "2.9.1"
  }
}
